{
  "name": "geovibe-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Single-date global Sentinel-2 monitoring with six-month NDVI, NDWI, flood and drought outlooks.",
  "scripts": {
    "start": "python app.py",
    "start:node": "node server.js",
    "train": "node training/flood/train-sen1floods11.js",
    "train:inventory": "set INVENTORY_ONLY=1&& node training/flood/train-sen1floods11.js",
    "prepare:flood-forecast": "python training/flood/prepare-glofas-forecast.py",
    "train:flood-forecast": "node training/flood/train-glofas-forecast.js",
    "prepare:flood-plus1": "python training/flood/prepare-glofas-plus1.py",
    "train:flood-plus1": "node training/flood/train-glofas-plus1.js",
    "prepare:forecast": "python training/forecast/prepare-forecast-data.py",
    "enrich:forecast": "python training/forecast/enrich-forecast-spei.py",
    "train:forecast": "node training/forecast/train-forecast.js",
    "train:drought": "node training/drought/train-drought-forecast.js",
    "prepare:drought": "python training/prepare-drought-data.py",
    "enrich:drought-seasonal": "python training/enrich-drought-seasonal.py",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "geotiff": "^2.1.3",
    "leaflet": "^1.9.4"
  }
}
